.page {
  min-height: 100vh;
  padding: 30rpx 24rpx 40rpx;
  background-color: #f2eee9;
  padding-bottom: 110rpx;

}
.top {
  margin-bottom: 30rpx;
}
.profile {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}
.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(245, 138, 112, 0.35);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.1);
  margin-right: 20rpx;
}
.greeting .title {
  font-size: 38rpx;
  font-weight: 600;
  color: rgba(47, 53, 66, 0.92);
}
.greeting .subtitle {
  font-size: 26rpx;

  color:#c49a93;
  margin-top: 10rpx;
}
.health-card {
  background: linear-gradient(135deg, #ffffff 0%, #fbf6f3 100%);
  border-radius: 26rpx;
  padding: 30rpx 26rpx;
  box-shadow: 0 16rpx 28rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid #DFD3C3;
  overflow: hidden;
}
.health-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 26rpx;
}
.health-label {
  font-size: 24rpx;
  color: rgba(94, 105, 124, 0.7);
}
.health-value {
  display: flex;
  align-items: flex-end;
  margin-top: 8rpx;
}
.health-value .value {
  font-size: 62rpx;
  font-weight: 700;
  color: rgba(47, 53, 66, 0.9);
  line-height: 1;
}
.health-value .unit {
  font-size: 28rpx;
  color: rgba(94, 105, 124, 0.75);
  margin-left: 12rpx;
}
.health-status {
  background:  #f7f0ef;
  color: #A66159;
  padding: 10rpx 18rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}
.trend {
  margin-bottom: 26rpx;
}
.trend-title {
  font-size: 26rpx;
  color: rgba(94, 105, 124, 0.8);
  margin-bottom: 14rpx;
}
.trend-chart {
  position: relative;
  height: 130rpx;
  border-radius: 18rpx;
  background: radial-gradient(circle at top, rgba(255, 145, 124, 0.12), transparent 60%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0));
  overflow: hidden;
  padding: 18rpx 18rpx 22rpx;
}
.trend-chart .dot {
  position: absolute;
  left: 0;
  width: 14rpx;
  height: 14rpx;
  background: rgba(245, 138, 112, 0.95);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(245, 138, 112, 0.3);
  transform: translateX(-50%);
}
.trend-chart .dot:nth-child(1) { left: 10%; }
.trend-chart .dot:nth-child(2) { left: 33%; }
.trend-chart .dot:nth-child(3) { left: 56%; }
.trend-chart .dot:nth-child(4) { left: 79%; }
.trend-chart .trend-axis {
  position: absolute;
  bottom: 10rpx;
  left: 18rpx;
  right: 18rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: rgba(94, 105, 124, 0.45);
}
.fiber {
  padding: 18rpx 16rpx 14rpx;
  background: rgba(255, 238, 221, 0.8);
  border-radius: 18rpx;
}
.fiber-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.fiber-title {
  font-size: 26rpx;
  color: rgba(94, 105, 124, 0.75);
}
.fiber-progress {
  font-size: 24rpx;
  color: rgba(47, 53, 66, 0.85);
}
.fiber-bar {
  height: 18rpx;
  /* background: rgba(255, 145, 124, 0.25); */
  background: #f1f5f9;
  border-radius: 12rpx;
  overflow: hidden;
}
.fiber-fill {
  height: 100%;
  background: #a66159;
}
.section {
  margin-bottom: 30rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(47, 53, 66, 0.88);
  margin-bottom: 18rpx;
}
.tool-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx;
}
.tool-card {
  width: 40%;
  padding: 30rpx 18rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid rgba(255, 145, 124, 0.25);
  box-shadow: 0 12rpx 22rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}
.tool-card:active {
  transform: translateY(2rpx);
  background: #a6625a;
}
.tool-icon {
  font-size: 48rpx;
  margin-bottom: 14rpx;
}
.tool-title {
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  color: rgba(47, 53, 66, 0.9);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.section-link {
  font-size: 24rpx;
  color: #a66159;
}
.article-row {
  display: flex;
  gap: 18rpx;
  overflow-x: auto;
  padding-bottom: 6rpx;
  height:450rpx;
  width:100%;
}
.article-card {
  width: 100%;
  background: #ffffff;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(245, 138, 112, 0.2);
}
.article-cover {
  width: 100%;
  height: 220rpx;
}
.article-info {
  padding: 18rpx 16rpx 22rpx;
  height:200rpx;
}
.article-tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  border-radius: 14rpx;
  background: #f7f0ef;
  color: #a66159;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.article-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(47, 53, 66, 0.95);
  margin-bottom: 10rpx;
  font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
}
.article-meta {
  font-size: 22rpx;
  color: rgba(94, 105, 124, 0.6);
}
