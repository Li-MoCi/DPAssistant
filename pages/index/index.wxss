.container {
  padding: 20rpx;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.1) 0 8rpx,
    transparent 8rpx 16rpx
  ),
  linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}
.header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(63, 81, 181, 0.25);
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid rgba(63, 81, 181, 0.45);
}
.greeting {
  font-size: 36rpx;
  font-weight: 500;
  color: rgba(63, 81, 181, 0.85);
}
.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  width: 48%;
  background: linear-gradient(135deg, #ffffff 0%, #f0f4ff 100%);
  border-radius: 18rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.13), 0 6rpx 20rpx rgba(63, 81, 181, 0.08);
  border: 1rpx solid transparent;
  border-image: repeating-linear-gradient(
    45deg,
    rgba(63, 81, 181, 0.25) 0 4rpx,
    transparent 4rpx 8rpx
  ) 1;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}
.card::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(63, 81, 181, 0.06) 0 12rpx,
    transparent 12rpx 24rpx
  );
  opacity: 0.5;
  pointer-events: none;
}
.card:active {
  transform: translateY(2rpx);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.16), 0 5rpx 18rpx rgba(63, 81, 181, 0.12);
}
.card-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(63, 81, 181, 0.25));
}
.card-title {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
  color: rgba(63, 81, 181, 0.85);
}
.card-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  display: block;
}