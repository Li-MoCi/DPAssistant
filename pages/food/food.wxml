<view class="container">

  <view class="scanner">
    <image class="food-preview" src="{{recognizedFood && recognizedFood.image ? recognizedFood.image : defaultImage}}" mode="aspectFill" />
    <view class="scanner-actions">
      <button class="scan-btn" bindtap="takePhoto">📷 拍照</button>
      <button class="scan-btn" bindtap="uploadImage">🖼 相册</button>
      <button class="scan-btn" bindtap="confirmRecord" wx:if="{{recognizedFood}}">✅ 保存</button>
    </view>
  </view>
  <view class="overlay"  wx:if="{{recognizedFood}}">
      <view class="sugar">
        <view class="sugar-label">估算含糖量</view>
        <view>        <text class="sugar-value">{{recognizedFood ? recognizedFood.sugar : 0}}</text>
        <text class="sugar-unit">克</text></view>
      </view>
    </view>

  <view class="intake"  wx:if="{{recognizedFood}}">
    <view class="intake-header">
      <text class="intake-title">每日糖分摄入</text>
      <text class="intake-count">{{dailySugar}}g / {{dailyLimit}}g</text>
    </view>
    <view class="intake-bar">
      <view class="intake-fill" style="width: {{dailyProgress}}%;"></view>
    </view>
    <text class="intake-tip" >本餐含糖量较高，请注意控制分量。</text>
  </view>

  <view class="advice"  wx:if="{{recognizedFood}}">
    <text class="advice-title">AI 营养建议</text>
    <view class="advice-card">
      <text>建议：改选荞麦面，搭配鸡胸肉和大量绿叶蔬菜。</text>
      <view class="advice-note">贴士：先吃蔬菜，再吃面条，有助于稳定餐后血糖。</view>
    </view>
    <view class="advice-actions">
      <button class="outline" bindtap="generateWeekReport">保存到日记</button>
      <button class="primary" bindtap="generateWeekReport">营养详情</button>
    </view>
  </view>
</view>