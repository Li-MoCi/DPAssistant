.container {
  min-height: 100vh;
  background-color: #f7f6f6;
  padding: 26rpx 22rpx 32rpx;
}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.back,
.action {
  font-size: 34rpx;
  color: rgba(47, 53, 66, 0.85);
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(47, 53, 66, 0.9);
}
.scanner {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(248, 244, 242, 0.85));
  border-radius: 26rpx;
  padding: 18rpx;
  box-shadow: 0 16rpx 24rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.food-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 22rpx;
  object-fit: cover;
}
.overlay {
  position: absolute;
  top: 70rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80%;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0);
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sugar {
  background-color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding:20px;
  border-radius: 12px;
  border:1px solid #e6d7d5;
  /* gap: 10rpx; */
}
.sugar-label {
  font-size: 24rpx;
  color: #a66159;
}
.sugar-value {
  font-size: 60rpx;
  font-weight: 700;
  color: rgba(47, 53, 66, 0.9);
}
.sugar-unit {
  font-size: 26rpx;
  color: #0f172a;
}
.scanner-actions {
  gap:16px;
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}
.scan-btn {
  flex: 1;
  margin: 0 6rpx;
  padding: 18rpx 0;
  border-radius: 32rpx;
  border: none;
  background: #a6625a;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(245, 138, 112, 0.25);
}
.intake {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 26rpx;
  padding: 24px 20px;
  box-shadow: 0 16rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 22rpx;
}
.intake-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.intake-title {
  font-size: 28rpx;
  color: #000;
  font-weight: 400;
}
.intake-count {
  font-size: 26rpx;
  color: #a66159;
}
.intake-bar {
  height: 20rpx;
  background: #f7f0ef;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12px;
  margin-top: 12px;
}
.intake-fill {
  height: 100%;
  background: #a66159;
}
.intake-tip {
  font-size: 24rpx;
  color: #a66159;
}
.advice {
  padding: 22rpx 20rpx;
  background: #f7f6f6;
  border-radius: 26rpx;
}
.advice-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(47, 53, 66, 0.9);
  margin-bottom: 16px;
  margin-top: 24px;
}
.advice-card {
  padding: 20px;
  background: #f2eeed;
  border-radius: 22rpx;
  margin-top: 18rpx;
  margin-bottom: 18rpx;
}
.advice-card text {
  display: block;
  font-size: 26rpx;
  color: rgba(47, 53, 66, 0.85);
  margin-bottom: 10rpx;
}
.advice-note {
  font-size: 24rpx;
  color: rgba(94, 105, 124, 0.75);
  border-radius: 24px;
  background-color: #fff;
  margin-top: 4rpx;
  padding:12px;
}
.advice-actions {
  display: flex;
  gap: 16rpx;
}
.outline {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 24px;
  background: #a6625a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  width:157px;

}
.primary {

  flex: 1;
  padding: 18rpx 0;
  border-radius: 24px;
  border:1px solid #eddfde;
  background: #fff;
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
  width:157px;
}
