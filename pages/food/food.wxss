.container {
  padding: 20rpx;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.1) 0 10rpx,
    transparent 10rpx 20rpx
  ),
  linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}
.section {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12), 0 6rpx 18rpx rgba(63, 81, 181, 0.08);
  border: 1rpx solid transparent;
  border-image: repeating-linear-gradient(
    45deg,
    rgba(63, 81, 181, 0.25) 0 4rpx,
    transparent 4rpx 8rpx
  ) 1;
}
button {
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, rgba(63, 81, 181, 0.95) 0%, rgba(63, 81, 181, 0.75) 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(63, 81, 181, 0.25);
  transition: all 0.3s ease;
}
button:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(63, 81, 181, 0.3);
}
.recognized-card {
  background: linear-gradient(135deg, #e8f5e9 0%, #d4edda 100%);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #28a745;
}
.record-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(63, 81, 181, 0.1);
}
.report-card {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #f0f4ff 0%, #e3f2fd 100%);
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(63, 81, 181, 0.2);
}
.section-title {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
  color: rgba(63, 81, 181, 0.85);
}