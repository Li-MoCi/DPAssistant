.container {
  padding: 20rpx;
}
.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
button {
  margin-bottom: 16rpx;
}
.recognized-card {
  background: #e8f5e9;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.record-item {
  padding: 16rpx 0;
  border-bottom: 1px solid #eee;
}
.report-card {
  margin-top: 20rpx;
  background: #f0f8ff;
  padding: 20rpx;
  border-radius: 12rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
}