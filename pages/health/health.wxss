.container {
  padding: 20rpx;
}
.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
}
.picker {
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
input {
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.advice-card {
  background: #e3f2fd;
  padding: 20rpx;
  border-radius: 12rpx;
}