.container {
  padding: 20rpx;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.1) 0 10rpx,
    transparent 10rpx 20rpx
  ),
  linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}
.section {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12), 0 6rpx 18rpx rgba(63, 81, 181, 0.08);
  border: 1rpx solid transparent;
  border-image: repeating-linear-gradient(
    45deg,
    rgba(63, 81, 181, 0.25) 0 4rpx,
    transparent 4rpx 8rpx
  ) 1;
}
.section-title {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
  color: rgba(63, 81, 181, 0.85);
}
.article-card {
  background: linear-gradient(135deg, #f1f8e9 0%, #e8f5e8 100%);
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #4caf50;
  transition: all 0.3s ease;
}
.article-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.15);
}
.article-title {
  font-size: 36rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
  color: rgba(63, 81, 181, 0.85);
}
.article-summary {
  color: #666;
}
.article-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(63, 81, 181, 0.1);
  position: relative;
}
.article-item::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: repeating-linear-gradient(
    135deg,
    rgba(63, 81, 181, 0.2) 0 6rpx,
    transparent 6rpx 12rpx
  );
}
.article-item:last-child {
  border-bottom: none;
}